--
-- Change Log.
--
-- 20-06-2017   houyingli File creation
--

INSPUR-EXT-MIB DEFINITIONS::= BEGIN
IMPORTS 
    enterprises, MODULE-IDENTITY,OBJECT-TYPE,
        FROM SNMPv2-SMI
 	TEXTUAL-CONVENTION, DisplayString
    	FROM SNMPv2-TC;        
    
inspur OBJECT IDENTIFIER::={ enterprises 48512 }
 
device OBJECT IDENTIFIER::={ inspur 1 }

systemstorage OBJECT IDENTIFIER::={ device 101 }
physicalstorage OBJECT IDENTIFIER::={ systemstorage 1 }
mdiskstorage OBJECT IDENTIFIER::={ systemstorage 2 }
poolstorage OBJECT IDENTIFIER::={ systemstorage 3 }

performance OBJECT IDENTIFIER::={ device 107 }
information OBJECT IDENTIFIER::={ device 108 }
expandCardInfo OBJECT IDENTIFIER::={ information 11 }	
clusterparameter OBJECT IDENTIFIER::={ inspur 2 }
   

clusterName OBJECT-TYPE
			 SYNTAX   DisplayString 
			 MAX-ACCESS  read-write
			 STATUS      current
			 DESCRIPTION "The name of the cluster"
			 ::= { clusterparameter 1 }
clusterStatus OBJECT-TYPE
			 SYNTAX   DisplayString 
			 MAX-ACCESS  read-only
			 STATUS      current
			 DESCRIPTION "The status of the cluster"
			 ::= { clusterparameter 2 }
clusterTime OBJECT-TYPE
			 SYNTAX   DisplayString 
			 MAX-ACCESS  read-write
			 STATUS      current
			 DESCRIPTION "The time of the cluster"
			 ::= { clusterparameter 3 }		
clusterSysVersion OBJECT-TYPE
			 SYNTAX   DisplayString 
			 MAX-ACCESS  read-only
			 STATUS      current
			 DESCRIPTION "The version of the cluster's software"
			 ::= { clusterparameter 4 }			 
clusterConfigTable  OBJECT-TYPE
			SYNTAX SEQUENCE OF ClusterConfigEntry
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION "The table of the MDISK performance information"
			::= { clusterparameter 5 }
			
clusterConfigEntry OBJECT-TYPE
			SYNTAX ClusterConfigEntry
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION "An entry (conceptual row )in the mdisk table"	
			INDEX { nodeIndex }
			::= { clusterConfigTable 1 }      
			
ClusterConfigEntry ::=
			SEQUENCE {
				nodeIndex			INTEGER, 
				nodeName					DisplayString,
				nodeCPUCount				DisplayString,	
				nodeCPUSocket				DisplayString,
				nodeCPUConfigured			DisplayString,
				nodeCPUActual				DisplayString,
				nodeMemoryConfigured		DisplayString,
				nodeMemoryReal      		DisplayString,
				ioGroupID					DisplayString,
				ioGroupName					DisplayString	
			 }		
nodeIndex OBJECT-TYPE
			SYNTAX  INTEGER (1..2147483647)
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION "Indicates the node or node canister unique ID"
			::= { clusterConfigEntry 1 }		
nodeName OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION "Indicates the node or node canister name"
			::= { clusterConfigEntry 2 }	
nodeCPUCount OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION "Indicates the maximum number of CPUs
						for the node."
			::= { clusterConfigEntry 3 }
nodeCPUSocket OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION "Indicates the ID of socket the CPU fields
						 refer to"
			::= { clusterConfigEntry 4 }	
nodeCPUConfigured OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION "Indicates the configured CPU for this socket"
			::= { clusterConfigEntry 5 }
nodeCPUActual OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION "Indicates the currently installed CPU in this socket"
			::= { clusterConfigEntry 6 }
nodeMemoryConfigured OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION "Indicates the configured amount of memory (in GB)"
			::= { clusterConfigEntry 7 }
nodeMemoryReal OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION "Indicates the currently installed amount of memory (in GB)"
			::= { clusterConfigEntry 8 }
ioGroupID OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION "Indicates the input/output (I/O) group ID."
			::= { clusterConfigEntry 9 }
ioGroupName OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION "Indicates the I/O group name."
			::= { clusterConfigEntry 10 }			
			

enclosureStatusTable  OBJECT-TYPE
			SYNTAX SEQUENCE OF EnclosureStatusEntry
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION "The table of the enclosure status"
			::= { clusterparameter 6 }
			
enclosureStatusEntry OBJECT-TYPE
			SYNTAX EnclosureStatusEntry
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION "An entry (conceptual row )in the enclosure status table"	
			INDEX { enclosureID }
			::= { enclosureStatusTable 1 }      
			
EnclosureStatusEntry ::=
			SEQUENCE {
				enclosureID				INTEGER, 
				enclosure-status		DisplayString,
				enclosure-type			DisplayString,
				enclosure-managed		DisplayString
			 }		
enclosureID OBJECT-TYPE
			SYNTAX  INTEGER (1..2147483647)
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION "Indicates the ID of the enclosure.   "
			::= { enclosureStatusEntry 1 }		
enclosure-status OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION "Indicates if an enclosure is visible to the SAS
				network:                                           
				* online if a managed or unmanaged enclosure is   
				visible                                            
				* offline if a managed enclosure is not visible,  
				and other fields hold their last known values.  
				* degraded if an enclosure is visible, but not
				down both strands     "
			::= { enclosureStatusEntry 2 }	
enclosure-type OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION "Indicates the type of enclosure:
					* control
					* expansion   "
			::= { enclosureStatusEntry 3 }	
enclosure-managed OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION "Indicates if the enclosure is managed:
				* yes 
				* no    "
			::= { enclosureStatusEntry 4 }	
			
clusterIPInfoTable  OBJECT-TYPE
			SYNTAX SEQUENCE OF ClusterIPInfoEntry
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION "The table of the MDISK performance information"
			::= { clusterparameter 7 }
			
clusterIPInfoEntry OBJECT-TYPE
			SYNTAX ClusterIPInfoEntry
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION "An entry (conceptual row )in the cluster ip info table"	
			INDEX { portID, clusterID }
			::= { clusterIPInfoTable 1 }      
			
ClusterIPInfoEntry ::=
			SEQUENCE {
				portID				INTEGER,
				clusterID			DisplayString, 
				ipInfo-clusterName	DisplayString,
				ipInfo-location		DisplayString,
				ipInfo-ipAddress	DisplayString,
				ipInfo-subnetMask	DisplayString,
				ipInfo-gateway		DisplayString,
				ipInfo-ipAddress6	DisplayString,   
				ipInfo-prefix6		DisplayString,
				ipInfo-gateway6		DisplayString
			 }	
portID OBJECT-TYPE
			SYNTAX  INTEGER (1..2147483647)
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION "The port index of the ip info table"
			::= { clusterIPInfoEntry 1 }			 
clusterID OBJECT-TYPE
			SYNTAX  DisplayString
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION "The cluster index of the ip info table"
			::= { clusterIPInfoEntry 2 } 
ipInfo-clusterName OBJECT-TYPE
			SYNTAX  DisplayString
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION "The cluster name of the ip info table"
			::= { clusterIPInfoEntry 3 }
ipInfo-location OBJECT-TYPE
			SYNTAX  DisplayString
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION "The location of the ip info table"
			::= { clusterIPInfoEntry 4 }
ipInfo-ipAddress OBJECT-TYPE
			SYNTAX  DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION "The IPv4 address of the ip info table"
			::= { clusterIPInfoEntry 5 }
ipInfo-subnetMask OBJECT-TYPE
			SYNTAX  DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION "The IPv4 subnetMask of the ip info table"
			::= { clusterIPInfoEntry 6 }
ipInfo-gateway OBJECT-TYPE
			SYNTAX  DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION "The IPv4 gateway of the ip info table"
			::= { clusterIPInfoEntry 7 }
ipInfo-ipAddress6 OBJECT-TYPE
			SYNTAX  DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION "The IPv6 address of the ip info table"
			::= { clusterIPInfoEntry 8 }
ipInfo-prefix6 OBJECT-TYPE
			SYNTAX  DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION "The IPv6 prefix of the ip info table"
			::= { clusterIPInfoEntry 9 }
ipInfo-gateway6 OBJECT-TYPE
			SYNTAX  DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION "The IPv6 gateway of the ip info table"
			::= { clusterIPInfoEntry 10 }

clusterIPTable  OBJECT-TYPE
			SYNTAX SEQUENCE OF ClusterIPEntry
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION "The table of the MDISK performance information"
			::= { clusterparameter 8 }
			
clusterIPEntry OBJECT-TYPE
			SYNTAX ClusterIPEntry
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION "An entry (conceptual row )in the cluster cluster IP table"	
			INDEX { clusterIP-portID }
			::= { clusterIPTable 1 }      
			
ClusterIPEntry ::=
			SEQUENCE {
				clusterIP-portID        INTEGER,
				clusterIP-clusterID     DisplayString, 
				clusterIP-clusterName   DisplayString,
				clusterIP-location      DisplayString,
				clusterIP-ipAddress     DisplayString,
				clusterIP-subnetMask    DisplayString,
				clusterIP-gateway       DisplayString,
				clusterIP-ipAddress6    DisplayString,   
				clusterIP-prefix6       DisplayString,
				clusterIP-gateway6      DisplayString
			 }	
clusterIP-portID OBJECT-TYPE
			SYNTAX  INTEGER (1..2147483647)
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION "The port ID of the cluster IP table"
			::= { clusterIPEntry 1 }			 
clusterIP-clusterID OBJECT-TYPE
			SYNTAX  DisplayString
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION "The cluster ID of the cluster IP table"
			::= { clusterIPEntry 2 } 
clusterIP-clusterName OBJECT-TYPE
			SYNTAX  DisplayString
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION "The cluster name of the cluster IP table"
			::= { clusterIPEntry 3 }
clusterIP-location OBJECT-TYPE
			SYNTAX  DisplayString
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION "The location of the cluster IP table"
			::= { clusterIPEntry 4 }
clusterIP-ipAddress OBJECT-TYPE
			SYNTAX  DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION "The IPv4 address of the cluster IP table"
			::= { clusterIPEntry 5 }
clusterIP-subnetMask OBJECT-TYPE
			SYNTAX  DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION "The IPv4 subnetMask of the cluster IP table"
			::= { clusterIPEntry 6 }
clusterIP-gateway OBJECT-TYPE
			SYNTAX  DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION "The IPv4 gateway of the cluster IP table"
			::= { clusterIPEntry 7 }
clusterIP-ipAddress6 OBJECT-TYPE
			SYNTAX  DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION "The IPv6 address of the cluster IP table"
			::= { clusterIPEntry 8 }
clusterIP-prefix6 OBJECT-TYPE
			SYNTAX  DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION "The IPv6 prefix of the cluster IP table"
			::= { clusterIPEntry 9 }
clusterIP-gateway6 OBJECT-TYPE
			SYNTAX  DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION "The IPv6 gateway of the cluster IP table"
			::= { clusterIPEntry 10 }
			 
physicalStorageTotal  OBJECT-TYPE
			 SYNTAX   DisplayString 
			 MAX-ACCESS  read-only
			 STATUS      current
			 DESCRIPTION "The whole capacity of the storage"
			 ::= { physicalstorage 1 }
	 
physicalStorageUsed  OBJECT-TYPE
			 SYNTAX   DisplayString 
			 MAX-ACCESS  read-only
			 STATUS      current
			 DESCRIPTION "The storage capacity that have been used"
			 ::= { physicalstorage 2 }
	 
physicalStorageAvailable  OBJECT-TYPE
			 SYNTAX   DisplayString 
			 MAX-ACCESS  read-only
			 STATUS      current
			 DESCRIPTION "The storage that can be used"
			 ::= { physicalstorage 3 }
			 
poolStorageTotal  OBJECT-TYPE
			 SYNTAX   DisplayString 
			 MAX-ACCESS  read-only
			 STATUS      current
			 DESCRIPTION "The whole capacity of the storage"
			 ::= { poolstorage 1 }
	 
poolStorageUsed  OBJECT-TYPE
			 SYNTAX   DisplayString 
			 MAX-ACCESS  read-only
			 STATUS      current
			 DESCRIPTION "The storage capacity that have been used"
			 ::= { poolstorage 2 }
	 
poolStorageAvailable  OBJECT-TYPE
			 SYNTAX   DisplayString 
			 MAX-ACCESS  read-only
			 STATUS      current
			 DESCRIPTION "The storage that can be used"
			 ::= { poolstorage 3 }
			 
mdiskStorageTotal  OBJECT-TYPE
			 SYNTAX   DisplayString 
			 MAX-ACCESS  read-only
			 STATUS      current
			 DESCRIPTION "The whole capacity of the storage"
			 ::= { mdiskstorage 1 }
	 
mdiskStorageUsed  OBJECT-TYPE
			 SYNTAX   DisplayString 
			 MAX-ACCESS  read-only
			 STATUS      current
			 DESCRIPTION "The storage capacity that have been used"
			 ::= { mdiskstorage 2 }
	 
mdiskStorageAvailable  OBJECT-TYPE
			 SYNTAX   DisplayString 
			 MAX-ACCESS  read-only
			 STATUS      current
			 DESCRIPTION "The storage that can be used"
			 ::= { mdiskstorage 3 }

mDISKTable  OBJECT-TYPE
			SYNTAX SEQUENCE OF MDISKEntry
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION "The table of the MDISK performance information"
			::= { performance 1 }
			
mDISKEntry OBJECT-TYPE
			SYNTAX MDISKEntry
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION "An entry (conceptual row )in the mdisk table"	
			INDEX { mDISKIndex }
			::= { mDISKTable 1 }      
			
MDISKEntry ::=
			SEQUENCE {
				mDISKIndex			INTEGER, 
				mDISK-Name			DisplayString,
				mDISK-Status		DisplayString,
				mDISK-Capacity		DisplayString,
				mDISK-Mode			DisplayString,
				mDISK-MdiskGrpID	DisplayString,
				mDISK-MdiskGrpName	DisplayString,
				mDISK-CtrlLUN		DisplayString,
				mDISK-ControllerName		DisplayString,
				mDISK-UID			DisplayString,
				mDISK-Tier			DisplayString,
				mDISK-Encripty		DisplayString,
				mDISK-SiteID		DisplayString,
				mDISK-SiteName		DisplayString,
				mDISK-Distributed			DisplayString,
				mDISK-Dedupe			DisplayString
			 }		
mDISKIndex OBJECT-TYPE
			SYNTAX  INTEGER (1..2147483647)
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION "The index of MDISK"
			::= { mDISKEntry 1 }		
mDISK-Name OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION "The name of MDISK"
			::= { mDISKEntry 2 }	
mDISK-Status OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION "The Status of MDISK, include : 
				* online                                         
				* offline                                        
				* excluded                                       
				* degraded_paths                                 
				* degraded_ports                                 
				* degraded (applies only to internal MDisks) "
			::= { mDISKEntry 3 }	
mDISK-Capacity OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION "The Capacity of MDISK"
			::= { mDISKEntry 4 }	
mDISK-Mode OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION "The mode of MDISK, include 
				*unmanaged
				*managed
				*image
				*array"
			::= { mDISKEntry 5 }
mDISK-MdiskGrpID OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION "The group id of the mdisk"
			::= { mDISKEntry 6 }
mDISK-MdiskGrpName OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION "The group name of the mdisk"
			::= { mDISKEntry 7 }
mDISK-CtrlLUN OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION "The CtrlLUN of the mdisk"
			::= { mDISKEntry 8 }
mDISK-ControllerName OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION "The controller name of the mdisk"
			::= { mDISKEntry 9 }
mDISK-UID OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION "The UID of the mdisk"
			::= { mDISKEntry 10 }
mDISK-Tier OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION "The Tier of the mdisk"
			::= { mDISKEntry 11 }
mDISK-Encripty OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION "The Encripty of the mdisk"
			::= { mDISKEntry 12 }
mDISK-SiteID OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION "The SiteID of the mdisk"
			::= { mDISKEntry 13 }
mDISK-SiteName OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION "The SiteName of the mdisk"
			::= { mDISKEntry 14 }
mDISK-Distributed OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION "The Distributed of the mdisk"
			::= { mDISKEntry 15 }
mDISK-Dedupe OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION "The Dedupe of the mdisk"
			::= { mDISKEntry 16 }



systemStatsTable OBJECT-TYPE
			SYNTAX SEQUENCE OF SystemStatsEntry
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION "The table of the system status information"
			::= { performance 2 }
systemStatsEntry OBJECT-TYPE
			SYNTAX SystemStatsEntry
			MAX-ACCESS read-only			
			STATUS current
			DESCRIPTION "An entry (conceptual row )in the system status table"	
            INDEX { systemStatusIndex }
			::= { systemStatsTable 1 }
SystemStatsEntry ::=
			SEQUENCE {  
                systemStatusIndex       INTEGER,
				cpu-pc					DisplayString, 
				fc-mb                   DisplayString,
				fc-io					DisplayString,
				sas-mb					DisplayString,
				sas-io					DisplayString,
				iscsi-mb				DisplayString,
				iscsi-io				DisplayString,
				vdisk-mb				DisplayString,
				vdisk-io				DisplayString,
				vdisk-ms				DisplayString,
				mdisk-mb				DisplayString,
				mdisk-io				DisplayString,
				mdisk-ms				DisplayString,
				drive-mb				DisplayString,
				drive-io				DisplayString,
				drive-ms				DisplayString,
				cache-write-rate		DisplayString,
				cache-read-rate			DisplayString,
				vdisk-us				DisplayString,
				mdisk-us				DisplayString,
				drive-us				DisplayString,
				drive-us				DisplayString,
				rdma-front-mb			DisplayString,
				rdma-front-io			DisplayString,
				rdma-back-mb			DisplayString,
				rdma-back-io			DisplayString,
				rdma-cont-mb			DisplayString,
				rdma-cont-io			DisplayString,
				rdma-mb					DisplayString,
				rdma-io					DisplayString
			 }		
systemStatusIndex OBJECT-TYPE
			SYNTAX  INTEGER (1..2147483647)
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION "The index of systemStatus"
			::= { systemStatsEntry 1 }				 
cpu-pc OBJECT-TYPE
			SYNTAX  DisplayString
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION 
				"Displays the percentage of allocated CPU 
				capacity utilized for the system"
			::= { systemStatsEntry 2 }	
fc-mb OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-only			
			STATUS current
			DESCRIPTION 
				"Displays the total number of megabytes transferred 
				per second for Fibre Channel traffic on the system. 
				This value includes host I/O and 
				any bandwidth that is used for communication
				within the system. "
			::= { systemStatsEntry 3 }
fc-io OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION 
				"Displays the total input/output (I/O) operations  
				transferred per seconds for Fibre Channel traffic 
				on the system. This value includes host I/O and   
				any bandwidth that is used for communication      
				within the system."
			::= { systemStatsEntry 4 }	
			
sas-mb OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION 
				"Displays the total number of megabytes            
				transferred per second for serial-attached SCSI   
				(SAS) traffic on the system. This value includes  
				host I/O and bandwidth that is used for           
				background RAID activity.  "
			::= { systemStatsEntry 5 }
sas-io OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION 
				"Displays the total I/O operations transferred   
				per second for SAS traffic on the system. This   
				value includes host I/O and bandwidth that is    
				used for background RAID activity. "
			::= { systemStatsEntry 6 }			
iscsi-mb OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION 
				"Displays the total number of megabytes            
				transferred per second for iSCSI traffic on the   
				system. "
			::= { systemStatsEntry 7 }	
iscsi-io OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION 
				"Displays the total I/O operations transferred 
				per second for iSCSI traffic on the system."
			::= { systemStatsEntry 8 }
vdisk-mb OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION 
				"Displays the average number of megabytes          
				transferred per second for read and write         
				operations to volumes during the sample period."
			::= { systemStatsEntry 9 }			
vdisk-io OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION 
				"Displays the average amount of I/O operations    
				transferred per second for read and write        
				operations to volumes during the sample period."
			::= { systemStatsEntry 10 }			
vdisk-ms OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION 
				"Displays the average amount of time in            
				milliseconds that the system takes to respond to  
				read and write requests to volumes over the       
				sample period. "
			::= { systemStatsEntry 11 }
mdisk-mb OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION 
				"Displays the average number of megabytes 
				transferred per second for read and write         |
				 operations to MDisks during the sample period."
			::= { systemStatsEntry 12 }
mdisk-io OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION 
				"Displays the average amount of I/O operations     
				transferred per second for read and write         
				operations to MDisks during the sample period. "
			::= { systemStatsEntry 13 }
mdisk-ms OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION 
				"Displays the average amount of time in            
				milliseconds that the system takes to respond to  
